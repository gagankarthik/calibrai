# ─── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Calibr
# Set to "false" to use real API routes instead of mock data
NEXT_PUBLIC_USE_MOCK=true

# ─── NextAuth ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace_with_32_char_random_secret
NEXTAUTH_URL=http://localhost:3000

# ─── AWS Cognito — Company User Pool ────────────────────────────────────────
NEXT_PUBLIC_COGNITO_COMPANY_USER_POOL_ID=us-east-1_XXXXXXXXX
NEXT_PUBLIC_COGNITO_COMPANY_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_COMPANY_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── AWS Cognito — Talent User Pool ─────────────────────────────────────────
NEXT_PUBLIC_COGNITO_TALENT_USER_POOL_ID=us-east-1_XXXXXXXXX
NEXT_PUBLIC_COGNITO_TALENT_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_TALENT_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── AWS Core Credentials ────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=XXXXXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Database — AWS RDS PostgreSQL ──────────────────────────────────────────
DATABASE_URL=postgresql://calibr_user:your_password@your-rds-endpoint.us-east-1.rds.amazonaws.com:5432/calibr_prod
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ─── Redis — AWS ElastiCache ─────────────────────────────────────────────────
REDIS_URL=redis://your-elasticache-endpoint.cache.amazonaws.com:6379
REDIS_TOKEN=

# ─── AWS S3 — File Storage (resumes, avatars, attachments) ─────────────────
S3_BUCKET_NAME=calibr-uploads-production
S3_REGION=us-east-1
NEXT_PUBLIC_S3_BUCKET_URL=https://calibr-uploads-production.s3.us-east-1.amazonaws.com

# ─── AWS SES — Email Delivery ────────────────────────────────────────────────
SES_FROM_EMAIL=noreply@calibr.io
SES_FROM_NAME=Calibr
SES_REGION=us-east-1

# ─── AWS OpenSearch — Full-text candidate/job search ────────────────────────
OPENSEARCH_ENDPOINT=https://search-calibr-prod-xxxxxxxxxx.us-east-1.es.amazonaws.com
OPENSEARCH_USERNAME=calibr_admin
OPENSEARCH_PASSWORD=your_opensearch_password

# ─── AWS SQS — Background Job Queue ─────────────────────────────────────────
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/calibr-jobs-queue
SQS_REGION=us-east-1

# ─── Stripe — Payments & Subscriptions ──────────────────────────────────────
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=YOUR_STRIPE_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Stripe Price IDs (create in Stripe dashboard)
STRIPE_STARTER_MONTHLY_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_STARTER_ANNUAL_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_GROWTH_MONTHLY_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_GROWTH_ANNUAL_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_ENTERPRISE_ANNUAL_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxx

# ─── OpenAI — AI Matching Engine ────────────────────────────────────────────
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_ORG_ID=org-xxxxxxxxxxxxxxxxxxxx
# Model for candidate matching (gpt-4o recommended)
OPENAI_MATCH_MODEL=gpt-4o

# ─── Analytics — PostHog ────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ─── Error Tracking — Sentry ─────────────────────────────────────────────────
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxx@o0.ingest.sentry.io/0
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxx@o0.ingest.sentry.io/0
SENTRY_ORG=calibr
SENTRY_PROJECT=calibr-web
SENTRY_AUTH_TOKEN=YOUR_SENTRY_AUTH_TOKEN

# ─── Email — Resend (transactional email alternative to SES) ────────────────
# Optional: use Resend instead of SES for transactional emails
RESEND_API_KEY=YOUR_RESEND_API_KEY

# ─── Internal Security ───────────────────────────────────────────────────────
# Used for server-to-server API calls
INTERNAL_API_SECRET=generate_with_openssl_rand_hex_32
# CRON job secret (Vercel Cron or AWS EventBridge)
CRON_SECRET=generate_with_openssl_rand_hex_32

# ─── Feature Flags ───────────────────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_AI_MATCHING=true
NEXT_PUBLIC_ENABLE_VIDEO_INTERVIEWS=false
NEXT_PUBLIC_ENABLE_SALARY_INTELLIGENCE=true
NEXT_PUBLIC_MAINTENANCE_MODE=false

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ─── CDN ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CDN_URL=https://cdn.calibr.io
